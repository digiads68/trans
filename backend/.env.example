# ClipProxy API Configuration (OpenAI-compatible)
CLIPROXY_API_BASE=https://api.cliproxyapi.com/v1
CLIPROXY_API_KEY=your-api-key-here

# App Settings
DEBUG=true
BATCH_SIZE=20
MAX_CONCURRENT_REQUESTS=5

# Available LLM Models (comma-separated, customize based on your cliproxyapi plan)
# AVAILABLE_LLM_MODELS=["gpt-4o","gpt-4o-mini","claude-sonnet-4-20250514","gemini-2.0-flash"]
