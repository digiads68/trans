# ClipProxy API Configuration (OpenAI-compatible)
CLIPROXY_API_BASE=https://api.cliproxyapi.com/v1
CLIPROXY_API_KEY=your-api-key-here

# App Settings
DEBUG=false

# CORS Origins (comma-separated)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Translation settings
BATCH_SIZE=20
MAX_CONCURRENT_REQUESTS=5

# Upload limit (bytes, default 50MB)
MAX_UPLOAD_SIZE=50000000

# File store TTL (seconds, default 2 hours)
FILE_STORE_TTL=7200
FILE_CLEANUP_INTERVAL=1800

# Available LLM Models (JSON array, customize based on your cliproxyapi plan)
# AVAILABLE_LLM_MODELS=["gpt-4o","gpt-4o-mini","claude-sonnet-4-20250514","gemini-2.0-flash"]
